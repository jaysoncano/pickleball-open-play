# Postgres connection string. Local: `supabase start` prints it (DB_URL).
# Hosted Supabase: Project Settings → Database → Connection string (pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The first admin account: created the first time someone signs in at
# /admin/login with these, while no admin exists. Add more admins and
# change passwords under Admin → Settings afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string that signs sign-in cookies and email links:
# `openssl rand -hex 32`.
ADMIN_SECRET=

# Email for verification codes and receipts (Resend). Provision:
# `vercel integration add resend/resend-email`. Leave empty locally.
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
EMAIL_FROM="POP <no-reply@example.com>"

# Default entry for one pair, in whole currency units (e.g. 300), and the
# ISO currency code used on receipts and the desk.
OPEN_PLAY_FEE=
CURRENCY=PHP

# Local email testing: without RESEND_API_KEY, emails go to Supabase's
# Mailpit inbox. Open this URL to read them (`supabase start` runs it).
MAILPIT_URL=http://127.0.0.1:54324
# Supabase Studio (browse tables); `npm run dev` opens it.
SUPABASE_STUDIO_URL=http://127.0.0.1:54323
